              "raw": "{\n  \"countryName\": \"Spain\",\n  \"capital\": \"Madrid\",\n  \"region\": \"Europe\",\n  \"population\": 47351567,\n  \"currency\": \"Euro\",\n  \"currencySymbol\": \"€\",\n  \"flagUrl\": \"https://flagcdn.com/w320/es.png\",\n  \"approved\": true\n}"
