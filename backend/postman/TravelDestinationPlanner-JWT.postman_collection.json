{
  "info": {
    "_postman_id": "2c0a9ac3-d865-46aa-bf03-72d44f95d6e8",
    "name": "TravelDestinationPlanner JWT",
    "description": "JWT auth lifecycle for TravelDestinationPlanner API: sign-up, login, refresh, and role-based protected endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign Up (USER)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"normal.user\",\n  \"email\": \"user@example.com\",\n  \"password\": \"P@ssw0rd123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sign-up"
              ]
            },
            "description": "Creates a USER account and returns access/refresh tokens."
          },
          "response": []
        },
        {
          "name": "Sign Up (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin.user\",\n  \"email\": \"admin@example.com\",\n  \"password\": \"P@ssw0rd123\",\n  \"role\": \"ADMIN\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/sign-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sign-up"
              ]
            },
            "description": "Creates an ADMIN account and returns access/refresh tokens."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Login status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"accessToken\", jsonData.accessToken);",
                  "pm.environment.set(\"refreshToken\", jsonData.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{loginEmail}}\",\n  \"password\": \"{{loginPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Logs in and stores accessToken/refreshToken in environment variables."
          },
          "response": []
        },
        {
          "name": "Refresh",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Refresh status is 200\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.environment.set(\"accessToken\", jsonData.accessToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "refresh"
              ]
            },
            "description": "Uses refresh token to generate a new access token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Protected",
      "item": [
        {
          "name": "User Endpoint (USER or ADMIN)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/user/profile",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "user",
                "profile"
              ]
            },
            "description": "Should return 200 for USER and ADMIN when token is valid."
          },
          "response": []
        },
        {
          "name": "Admin Endpoint (ADMIN only)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/dashboard",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "dashboard"
              ]
            },
            "description": "Should return 200 only for ADMIN token, 403 for USER token."
          },
          "response": []
        }
      ]
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "loginEmail",
      "value": "admin@example.com"
    },
    {
      "key": "loginPassword",
      "value": "P@ssw0rd123"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ]
}
